# Public Supabase (safe for browser when RLS is enabled)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Optional fallback if you still use the legacy anon key name
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# App URL used for OAuth redirectTo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional transactional email (Resend HTTP API)
RESEND_API_KEY=
RESEND_FROM_EMAIL=HubForge <onboarding@resend.dev>

# GitHub App (repository sync — not Auth OAuth)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Optional error tracking (Sentry). Leave blank to disable reporting.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Optional: upload source maps during CI/deploy
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Soft free-tier packaging limits (billing/Stripe deferred until prices are set)
HF_LIMIT_ORGS_PER_USER=3
HF_LIMIT_PROJECTS_PER_ORG=10
HF_LIMIT_MEMBERS_PER_ORG=15
