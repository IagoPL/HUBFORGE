# Normalize text to LF in the repository and on checkout.
# Overrides core.autocrlf for matching paths. Do not renormalize
# the whole tree without reviewing impact first.

* text=auto eol=lf

# Explicit text types (LF)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.svg text eol=lf
*.toml text eol=lf
*.env text eol=lf
*.example text eol=lf
*.gitignore text eol=lf
*.prettierignore text eol=lf
*.editorconfig text eol=lf

# Windows scripts that require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.wasm binary
pnpm-lock.yaml -text
